<!-- section-brands-carousel.liquid | PERFECT CONTINUOUS SCROLL | NO STOPS -->

<div class="brands-slider-section" style="padding-top:{{ section.settings.padding_top }}px; padding-bottom:{{ section.settings.padding_bottom }}px;">
  <div
    class="brands-slider"
    data-icon-size="{{ section.settings.icon_size | default: 130 }}"
    data-gap-desktop="{{ section.settings.gap_desktop | default: 20 }}"
    data-gap-tablet="{{ section.settings.gap_tablet | default: 15 }}"
    data-gap-mobile="{{ section.settings.gap_mobile | default: 10 }}"
    data-speed="{{ section.settings.scroll_speed | default: 30 }}"
  >
    <div class="carousel-track">
      <div class="carousel-content">
        {% for block in section.blocks %}
          <div class="carousel-item">
            {% if block.settings.brand_link != blank %}
              <a href="{{ block.settings.brand_link }}" class="brand-item-link">
            {% endif %}
            
            {% if block.settings.brand_image != blank %}
              <div class="brand-circle">
                <img src="{{ block.settings.brand_image | image_url: width: 300 }}" alt="{{ block.settings.brand_name | escape }}" loading="lazy" />
              </div>
            {% endif %}
            
            {% if block.settings.brand_name != blank %}
              <p class="brand-name">{{ block.settings.brand_name }}</p>
            {% endif %}
            
            {% if block.settings.brand_link != blank %}
              </a>
            {% endif %}
          </div>
        {% endfor %}
      </div>
      <div class="carousel-content" aria-hidden="true">
        {% for block in section.blocks %}
          <div class="carousel-item">
            {% if block.settings.brand_link != blank %}
              <a href="{{ block.settings.brand_link }}" class="brand-item-link">
            {% endif %}
            
            {% if block.settings.brand_image != blank %}
              <div class="brand-circle">
                <img src="{{ block.settings.brand_image | image_url: width: 300 }}" alt="{{ block.settings.brand_name | escape }}" loading="lazy" />
              </div>
            {% endif %}
            
            {% if block.settings.brand_name != blank %}
              <p class="brand-name">{{ block.settings.brand_name }}</p>
            {% endif %}
            
            {% if block.settings.brand_link != blank %}
              </a>
            {% endif %}
          </div>
        {% endfor %}
      </div>
    </div>
  </div>
</div>

<style>
* {
  box-sizing: border-box;
}

.brands-slider-section {
  width: 100%;
  overflow: hidden;
}

.brands-slider {
  width: 100%;
  overflow: hidden;
  position: relative;
}

.carousel-track {
  display: flex;
  animation: scroll 60s linear infinite;
  width: fit-content;
}

.carousel-track:hover {
  animation-play-state: paused;
}

.carousel-content {
  display: flex;
  gap: 20px;
  padding-right: 20px;
}

.carousel-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12px;
  text-align: center;
  min-height: 200px;
  justify-content: flex-start;
  flex-shrink: 0;
  min-width: 150px;
  width: 150px;
}

.brand-item-link {
  text-decoration: none;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12px;
  color: inherit;
  width: 100%;
  cursor: pointer;
}

.brand-circle {
  width: 130px;
  height: 130px;
  border-radius: 50%;
  overflow: hidden;
  background: #f6f6f6;
  box-shadow: 0 2px 8px rgba(0,0,0,0.12);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.brand-circle img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  border-radius: 50%;
  display: block;
}

.brand-name {
  font-size: 14px;
  font-family: var(--font-body), sans-serif;
  color: #222;
  margin: 0;
  padding: 0;
  line-height: 1.3;
  max-width: 140px;
  word-break: break-word;
}

@keyframes scroll {
  0% {
    transform: translateX(0);
  }
  100% {
    transform: translateX(-50%);
  }
}

@media (max-width: 1200px) {
  .brand-circle {
    width: 100px;
    height: 100px;
  }
  
  .carousel-item {
    min-height: 160px;
    min-width: 110px;
    width: 110px;
  }
  
  .brand-name {
    font-size: 12px;
  }
  
  .carousel-content {
    gap: 15px;
    padding-right: 15px;
  }
}

@media (max-width: 768px) {
  .brand-circle {
    width: 80px;
    height: 80px;
  }
  
  .carousel-item {
    min-height: 130px;
    min-width: 90px;
    width: 90px;
  }
  
  .brand-name {
    font-size: 11px;
  }
  
  .carousel-content {
    gap: 10px;
    padding-right: 10px;
  }
}
</style>

<script>
document.addEventListener('DOMContentLoaded', function() {
  var el = document.querySelector('.brands-slider');
  if (!el) return;
  
  var speed = parseInt(el.getAttribute('data-speed')) || 30;
  var iconSize = parseInt(el.getAttribute('data-icon-size')) || 130;
  
  var track = el.querySelector('.carousel-track');
  
  // Set animation duration based on speed setting
  var duration = Math.max(30, 120 - speed);
  track.style.animation = `scroll ${duration}s linear infinite`;
  
  // Update sizes for different breakpoints
  function updateSizes() {
    var circles = el.querySelectorAll('.brand-circle');
    var currentSize = iconSize;
    
    if (window.innerWidth <= 1200) {
      currentSize = Math.round(iconSize * 0.77);
    }
    if (window.innerWidth <= 768) {
      currentSize = Math.round(iconSize * 0.62);
    }
    
    circles.forEach(function(circle) {
      circle.style.width = currentSize + 'px';
      circle.style.height = currentSize + 'px';
    });
  }
  
  updateSizes();
  window.addEventListener('resize', updateSizes);
});
</script>

{% schema %}
{
  "name": "Brands Carousel",
  "settings": [
    {
      "type": "range",
      "id": "scroll_speed",
      "label": "Scroll Speed",
      "min": 1,
      "max": 100,
      "step": 1,
      "default": 30,
      "info": "Higher = Faster continuous scroll"
    },
    {
      "type": "range",
      "id": "icon_size",
      "label": "Icon Size (px)",
      "min": 80,
      "max": 200,
      "step": 10,
      "default": 130
    },
    {
      "type": "range",
      "id": "gap_desktop",
      "label": "Gap Desktop (px)",
      "min": 10,
      "max": 100,
      "step": 5,
      "default": 20
    },
    {
      "type": "range",
      "id": "gap_tablet",
      "label": "Gap Tablet (px)",
      "min": 5,
      "max": 50,
      "step": 5,
      "default": 15
    },
    {
      "type": "range",
      "id": "gap_mobile",
      "label": "Gap Mobile (px)",
      "min": 5,
      "max": 30,
      "step": 5,
      "default": 10
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding Top (px)",
      "min": 0,
      "max": 120,
      "step": 4,
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding Bottom (px)",
      "min": 0,
      "max": 120,
      "step": 4,
      "default": 40
    }
  ],
  "blocks": [
    {
      "type": "brand",
      "name": "Brand",
      "settings": [
        {
          "type": "text",
          "id": "brand_name",
          "label": "Brand name"
        },
        {
          "type": "image_picker",
          "id": "brand_image",
          "label": "Brand image"
        },
        {
          "type": "url",
          "id": "brand_link",
          "label": "Brand link"
        }
      ]
    }
  ],
  "max_blocks": 20,
  "presets": [
    {
      "name": "Brands Carousel",
      "category": "Media",
      "blocks": [
        { "type": "brand" },
        { "type": "brand" },
        { "type": "brand" }
      ]
    }
  ]
}
{% endschema %}
